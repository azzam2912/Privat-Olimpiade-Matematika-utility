% helvethia.sty
% Tema "Helvethia" untuk handout A4 (Modul, Materi, Latihan, Solusi).
% Eksperimen: palet dan font dari IG-Post-Latex/azzam-helvethia.sty, tapi
% tata letaknya dirancang ulang untuk kertas A4:
%   - halaman krem dengan bingkai tipis dan sudut berwarna crimson,
%   - judul (\maketitle) berupa pita crimson penuh di atas halaman pertama,
%   - \part sebagai banner, \section dengan lencana nomor dan garis dua warna,
%   - kotak teori (definisi, fakta, teorema, lemma, contoh) dengan tcolorbox,
%   - "Solusi" dengan garis tepi kiri, nomor soal dalam lingkaran,
%   - tab nomor bab di tepi kanan setiap halaman (thumb index),
%   - header judul + nama bab, footer nama penulis + nomor halaman.
%
% Pemakaian (pengganti langsung azzam.sty, semua nama environment sama):
%   \documentclass[12pt]{scrartcl}
%   \usepackage{helvethia}
%
% Opsi:
%   print     halaman putih (hemat tinta saat dicetak), kotak tetap berbingkai
%   english   nama environment dalam bahasa Inggris (Theorem, Example, ...)
%   noframe   tanpa bingkai halaman
%   nothumb   tanpa tab nomor bab di tepi kanan
%   noasy     tanpa paket asymptote
%
% Makro tambahan:
%   \subtitle{...}        baris kecil di atas judul pada pita judul (KOMA)
%   \sumber{OSK 2013}     label sumber soal berbentuk pil emas
%   \helvethiafooter{...} teks footer kiri (default: nama penulis)
%
% Turunan dari azzam.sty (c) 2025 Azzam, yang merupakan turunan evan.sty
% (c) 2020 Evan Chen. Boost Software License 1.0 (lihat azzam.sty).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{helvethia}[2026/11/22 Helvethia A4 handout theme]

