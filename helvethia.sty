\newlength{\hv@heroheight}\setlength{\hv@heroheight}{7.4cm}

\newcommand{\hv@hero}{%
	\AtPageUpperLeft{%
		\begin{tikzpicture}[overlay]
			\shade[left color=crimsonink, right color=crimson]
				(0,0) rectangle (\paperwidth,-\hv@heroheight);
			\begin{scope}
				\clip (0,0) rectangle (\paperwidth,-\hv@heroheight);
				% lingkaran konsentris di kanan
				\foreach \i in {0,...,11}{
					\draw[white, opacity=0.09, line width=0.9pt]
						(\paperwidth-2.2cm,-2.6cm) circle[radius=0.7cm+\i*0.6cm];}
				% grid titik halus
				\foreach \x in {0,...,13}{\foreach \y in {0,...,10}{
					\fill[white, opacity=0.13]
						(\paperwidth-9.2cm+\x*0.5cm,-1.2cm-\y*0.5cm) circle[radius=0.9pt];}}
			\end{scope}
			\fill[gold] (0,-\hv@heroheight) rectangle (\paperwidth,-\hv@heroheight-2.5pt);
			\fill[gold] (2cm,-1.45cm) rectangle (3.1cm,-1.55cm);
			\node[anchor=north west, inner sep=0pt, text width=\paperwidth-4cm,
				align=left, text=white] at (2cm,-1.95cm) {%
				\ifx\@subtitle\@empty\else
					{\color{gold!55!white}\sffamily\bfseries\footnotesize
						\textls[180]{\MakeUppercase{\@subtitle}}\par}\vspace{7pt}%
				\fi
				{\sffamily\bfseries\fontsize{26}{30}\selectfont\linespread{1}\selectfont\@title\par}};
			\node[anchor=south west, inner sep=0pt, text width=\paperwidth-4cm,
				align=left, text=white!82!crimson, font=\sffamily\footnotesize\linespread{1.15}\selectfont]
				at (2cm,-\hv@heroheight+0.75cm) {\@author\par\vspace{2pt}\@date};
		\end{tikzpicture}}%
}

