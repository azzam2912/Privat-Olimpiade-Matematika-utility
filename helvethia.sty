%%fakesection Elemen kecil: tag, lencana, pil
% \hvtag{warna}{teks}: label kotak kecil, huruf kapital berspasi
\newcommand{\hvtag}[2]{%
	\tikz[baseline=(hvt.base)]\node[fill=#1, text=white, rounded corners=2pt,
		inner xsep=5pt, inner ysep=2.6pt,
		font=\sffamily\bfseries\scriptsize](hvt){\strut\textls[90]{\MakeUppercase{#2}}};}
% \hvtagline{warna}{teks}: versi garis tepi (untuk contoh dan soal)
\newcommand{\hvtagline}[2]{%
	\tikz[baseline=(hvt.base)]\node[draw=#1, line width=0.8pt, fill=surface,
		text=#1, rounded corners=2pt, inner xsep=5pt, inner ysep=2.2pt,
		font=\sffamily\bfseries\scriptsize](hvt){\strut\textls[90]{\MakeUppercase{#2}}};}
% \hvbadge{n}: nomor dalam lingkaran (soal pada enumerate)
\newcommand{\hvbadge}[1]{%
	\tikz[baseline=(hvb.base)]\node[circle, fill=crimson, text=white, inner sep=0pt,
		minimum size=1.45em, font=\sffamily\bfseries\footnotesize](hvb){#1};}
% \sumber{...}: asal soal
\newcommand{\sumber}[1]{%
	\tikz[baseline=(hvs.base)]\node[fill=gold!20!surface, draw=gold!60, line width=0.4pt,
		text=goldink, rounded corners=5pt, inner xsep=5pt, inner ysep=2pt,
		font=\sffamily\bfseries\scriptsize](hvs){\strut #1};\hspace{0.45em}}

%%fakesection Gaya teorema
% Gaya amsthm dengan kepala berupa tag berwarna. \thmnumber hilang sendiri
% untuk environment tanpa nomor.
\newcommand{\hv@thmstyle}[4]{% nama, macro tag, warna, spasi setelah kepala
	\newtheoremstyle{#1}{0pt}{0pt}{\normalfont}{}{\normalfont}{}{#4}%
		{#2{#3}{\thmname{##1}\thmnumber{ ##2}}\thmnote{\hspace{0.5em}{\bfseries\color{#3}##3}}}}
\hv@thmstyle{hvcrimson}{\hvtag}{crimson}{\newline}
\hv@thmstyle{hvnavy}{\hvtag}{navy}{\newline}
\hv@thmstyle{hvgold}{\hvtag}{gold}{\newline}
\hv@thmstyle{hvexample}{\hvtagline}{crimson}{\newline}
\hv@thmstyle{hvremark}{\hvtagline}{inksoft}{0.6em}
\hv@thmstyle{hvclaim}{\hvtag}{crimsonink}{0.6em}
\hv@thmstyle{hvproblem}{\hvtagline}{crimson}{0.6em}
\newtheoremstyle{hvplain}{8pt}{8pt}{\normalfont}{}{\bfseries\color{crimsonink}}{.}{0.5em}{}

% Kartu tcolorbox di sekeliling environment
\tcbset{
	hv/card/.style={
		enhanced, colback=surface, colframe=#1!22, boxrule=0.5pt,
		arc=4pt, sharp corners=west, left=11pt, right=11pt, top=7pt, bottom=8pt,
		before skip=12pt plus 2pt, after skip=10pt plus 2pt,
		overlay={\fill[#1] (frame.south west) rectangle ([xshift=3pt]frame.north west);},
		before upper={\setlist[enumerate,1]{label=\textbf{\color{#1}\arabic*.}, leftmargin=1.8em, itemsep=2pt}%
			\setlist[itemize,1]{label=\textcolor{#1}{\tiny$\blacksquare$}}},
	},
	hv/example/.style={
		enhanced, colback=crimson!5!surface, colframe=crimson!5!surface, boxrule=0pt,
		arc=4pt, left=11pt, right=11pt, top=7pt, bottom=8pt,
		before skip=12pt plus 2pt, after skip=4pt,
	},
	hv/side/.style={
		blanker, breakable, borderline west={1.4pt}{0pt}{#1},
		left=13pt, before skip=6pt plus 2pt, after skip=12pt plus 2pt,
	},
}

