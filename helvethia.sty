% Nomor bab untuk tab di tepi kanan dibaca lewat mark, supaya bab yang
% baru mulai di bawah halaman tidak salah menandai halaman itu.
\NewMarkClass{hvsec}
\NewMarkClass{hvsectitle}
% Bab yang berlaku di puncak halaman (TopMark); halaman yang belum punya
% bab sebelumnya memakai bab pertama di halaman itu (FirstMark).
\newif\ifhv@usefirst
\newcommand{\hv@readmarks}{%
	\edef\hv@tabnum{\TopMark{hvsec}}%
	\ifx\hv@tabnum\@empty\hv@usefirsttrue\edef\hv@tabnum{\FirstMark{hvsec}}\else\hv@usefirstfalse\fi}
\newcommand{\hv@headmark}{%
	\hv@readmarks
	\ifx\hv@tabnum\@empty\else
		\textcolor{crimson}{\hv@tabnum}\enskip
		\ifhv@usefirst\FirstMark{hvsectitle}\else\TopMark{hvsectitle}\fi
	\fi}
\newif\ifhv@titlepage \hv@titlepagefalse

\newcommand{\hv@pagedecor}{%
	\AtPageLowerLeft{%
		\begin{tikzpicture}[overlay]
			\ifhv@frame
				\draw[crimson!28, line width=0.4pt]
					(\hv@m,\hv@m) rectangle (\paperwidth-\hv@m,\paperheight-\hv@m);
				\begin{scope}[crimson, line width=1.5pt, line cap=rect]
					\draw (\hv@m,\hv@m+\hv@corner) -- (\hv@m,\hv@m) -- (\hv@m+\hv@corner,\hv@m);
					\draw (\paperwidth-\hv@m-\hv@corner,\hv@m) -- (\paperwidth-\hv@m,\hv@m)
						-- (\paperwidth-\hv@m,\hv@m+\hv@corner);
					\ifhv@titlepage\else
						\draw (\hv@m,\paperheight-\hv@m-\hv@corner) -- (\hv@m,\paperheight-\hv@m)
							-- (\hv@m+\hv@corner,\paperheight-\hv@m);
						\draw (\paperwidth-\hv@m-\hv@corner,\paperheight-\hv@m)
							-- (\paperwidth-\hv@m,\paperheight-\hv@m)
							-- (\paperwidth-\hv@m,\paperheight-\hv@m-\hv@corner);
					\fi
				\end{scope}
			\fi
			\ifhv@thumb\ifhv@titlepage\else
				\hv@readmarks
				\ifx\hv@tabnum\@empty\else
					\pgfmathsetmacro{\hv@tabpos}{mod(\hv@tabnum-1,9)}%
					\fill[crimson, rounded corners=3pt]
						(\paperwidth+4pt,\paperheight-3.6cm-\hv@tabpos*1.75cm)
						-- (\paperwidth-\hv@m,\paperheight-3.6cm-\hv@tabpos*1.75cm)
						-- (\paperwidth-\hv@m,\paperheight-4.95cm-\hv@tabpos*1.75cm)
						-- (\paperwidth+4pt,\paperheight-4.95cm-\hv@tabpos*1.75cm) -- cycle;
					\node[text=white, font=\sffamily\bfseries\small]
						at (\paperwidth-0.5\hv@m,\paperheight-4.275cm-\hv@tabpos*1.75cm) {\hv@tabnum};
				\fi
			\fi\fi
		\end{tikzpicture}}%
}
